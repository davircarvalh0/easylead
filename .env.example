# Server-only. Never prefix these secrets with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
# Public evaluator access is enabled for this prototype. Set false to require manual credentials.
APP_DEMO_ACCESS=true
# Optional while demo access is enabled:
APP_ACCESS_CODE=
SESSION_SECRET=
APP_ALLOWED_EMAILS=you@example.com
APP_WORKSPACE_ID=main

# Optional: exercise the production integration with npm run dev locally.
# VITE_APP_MODE=server
# APP_ORIGIN=http://localhost:5173

{
  "name": "central-citi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build:preview": "vite build --base ./ --outDir previa",
    "prepreview": "npm run build:preview",
    "preview": "vite preview --outDir previa --host 127.0.0.1",
    "check:preview": "node scripts/check-preview.mjs",
    "test:preview": "playwright test --config playwright.preview.config.js",
    "build:vercel": "node scripts/vercel-build.mjs",
    "db:init": "node --env-file=.env scripts/db-init.mjs",
    "db:seed": "node --env-file=.env scripts/db-seed.mjs",
    "test:cloud": "playwright test --config playwright.cloud.config.js",
    "check:deployment": "node scripts/check-deployment.mjs",
    "db:prepare:supabase": "node scripts/prepare-supabase-seed.mjs",
    "db:prepare:owners": "node scripts/prepare-business-owners.mjs",
    "db:prepare:demo": "node scripts/prepare-demo-update.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "border-beam": "1.4.1",
    "motion": "^14.14.0",
    "ogl": "^1.0.11",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.56.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": "24.x"
  }
}
